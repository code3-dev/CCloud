<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and earlier (Android 12+ reads data_extraction_rules.xml).
     The sync device id and membership are per installation: a restored copy would make two
     devices sign their changes with the same id, and the membership's key stays in the old
     device's Keystore anyway. -->
<full-backup-content>
    <exclude domain="file" path="sync_device_id" />
    <exclude domain="file" path="sync_state.bin" />
</full-backup-content>
