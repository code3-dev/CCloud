<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml for why the sync device id and membership are left out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sync_device_id" />
        <exclude domain="file" path="sync_state.bin" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="sync_device_id" />
        <exclude domain="file" path="sync_state.bin" />
    </device-transfer>
</data-extraction-rules>
